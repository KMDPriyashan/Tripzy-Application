{
  "expo": {
    "name": "Tripzy-Application",
    "slug": "Tripzy-Application",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tripzyapplication",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyATaHyVUefyJpWAOKlBAOONPWb4JiOpLlk"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TripzyApplication",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyATaHyVUefyJpWAOKlBAOONPWb4JiOpLlk"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tripzy to access your location for accurate weather forecasts.",
          "locationAlwaysPermission": "Allow Tripzy to use your location even when the app is in the background for weather updates.",
          "locationWhenInUsePermission": "Allow Tripzy to access your location while using the app for weather forecasts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02324c99-a847-4e47-91c2-ed2bbb2d0132"
      }
    }
  }
}
